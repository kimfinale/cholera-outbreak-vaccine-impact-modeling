scale_x_continuous(breaks=seq(1,15,2))+
coord_cartesian(clip = "off")
p2_tag <- p2 +
annotate("text", x = -Inf, y = Inf, label = "E",
hjust = hj, vjust = vj, size = sz) +
scale_x_continuous(breaks=seq(1,15,2))+
coord_cartesian(clip = "off")
p3_tag <- p3 +
annotate("text", x = -Inf, y = Inf, label = "F",
hjust = hj, vjust = vj, size = sz) +
scale_x_continuous("Delay in ORI implementation (weeks)",
breaks=seq(1,15,2))+
coord_cartesian(clip = "off")
plt4 <- (p1_tag / p2_tag / p3_tag) + plot_layout(ncol=1)
plts_3_4 <- (plt3 | plt4) + plot_layout(ncol=2) +
plot_layout(axis_titles = "collect_x")
fac <- 1.35
ggsave(paste0("plots/figs_3_4_pcr_capd_", tstamp(), ".pdf"),
plts_3_4,
device = cairo_pdf, width = fgw2*fac*fac,
height = fgw2*fac*fac, units = "mm")
