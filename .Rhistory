# Resolve package conflicts in favor of dplyr
conflict_prefer("filter", "dplyr")
conflict_prefer("select", "dplyr")
# Output control flags
save_plot <- FALSE
save_table <- FALSE
# Configure figure size settings
figure_size <- data.frame(
journal = "Lancet",
single = 85,   # Width for single-column figures (mm)
double = 178   # Width for double-column figures (mm)
)
fgw1 <- figure_size[figure_size$journal == "Lancet",]$single
fgw2 <- figure_size[figure_size$journal == "Lancet",]$double
# Color palette for consistent visualization
set1 <- brewer.pal(9, "Set1")  # color sets
my_discrete_colors <- c("#E41A1C", "#377EB8", "#4DAF4A", "#984EA3", "#FF7F00")
# Define standard probability values for quantiles
probs <- c(0.025, 0.25, 0.5, 0.75, 0.975)  # 2.5%, 25%, 50%, 75%, 97.5% quantiles
# Reference vaccination week
VW <- 9  # representative vaccination week from GTFCC data
# Sequence of vaccination weeks to evaluate
VW_seq <- seq(1, 15, 2)
# Representative vaccination coverage rate
VC <- 0.75  # 75% coverage
# Three representative vaccination coverage rates
VC3 <- c(0.6, 0.75, 0.9)  # 60%, 75%, 90%
# Thresholds for case-triggered vaccination to analyze
cts_sel <- c(1, seq(10, 100, 10))  # case triggers selected
# Latest date for which OCV campaign data is available
YEAR <- as.Date("2020-12-28")
# Load geographic data for mapping
shp <- st_read("data/shapefiles/total_shp_0427.shp", quiet = TRUE)
africa <- st_read("data/shapefiles/afr_g2014_2013_0.shp", quiet = TRUE)
# only a subset of sample runid's is used for plotting for convenience
set.seed(42)
sample_runids <- sample(1:200, size=30)
#| warning: false
# Load outbreak data
# All outbreaks including those affected by OCVs
outbreak_data_all <- as.data.frame(fread("outputs/outbreak_data_all_20250228.csv"))
# Outbreaks included in vaccine impact modeling (not affected by OCVs)
outbreak_data <- fread("outputs/outbreak_data_20250228.csv")
# outbreaks filtered
# This includes outbreaks that are finally analyzed and excludes
# outbreaks that were duplicated
outbreaks_filtered <-
readRDS("outputs/outbreak_summary_filtered_20250418.rds")
outbreak_data %<>% filter(id_outbreak %in% outbreaks_filtered$id_outbreak)
# outbreaks excluded
outbreaks_excluded <- read_rds("outputs/outbreaks_excluded_20250612.rds")
# Load OCV campaign data
ocv_use <- fread("outputs/ocv_use_GTFCC_data_20241120.csv")
# Calculate delay statistics between request and round 1 vaccination
delay_req_r1 <- as.integer(ocv_use$DATE_ROUND_ONE - ocv_use$DATE_REQUEST)
# Compute key percentiles of the delay distribution
ocv_delay <- quantile(delay_req_r1, probs = c(0.25, 0.5, 0.75, 0.9), na.rm = TRUE)
# Get historical OCV deployment data
dat <- clean_names(fread("data/OCV_Use_GTFCC_Dashboard.csv"))
dat |>
filter(shipped == "Shipped", type == "Reactive") |>
group_by(year) |>
summarize(num_ocv = sum(dose)) |>
setDT() -> ocv_year
ocv_year$cum_num_ocv <- cumsum(ocv_year$num_ocv)
# Load OCV campaign dataset
docv_ <- clean_names(fread("data/outbreak_files_Oct2024/ocv_long_dataset.csv"))
docv <- docv_[(ocv_before_1 == TRUE | ocv_before_2 == TRUE |
ocv_before_3 == TRUE | ocv_during == TRUE)]
# Load model parameters
