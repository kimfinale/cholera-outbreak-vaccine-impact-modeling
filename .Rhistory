fill = ar_per_10e3, shape = spatial_scale)) +
geom_point(size = 3.2, color = "grey20", stroke = 0.3) +  # color=outline; stroke=outline width
scale_shape_manual("",
values = c(admin1 = 21, admin2 = 22, admin3 = 24),
labels = c("adm 1", "adm 2", "adm 3")) +
scale_fill_gradientn(
trans = scales::pseudo_log_trans(),
colours = myPalette(100),
breaks = c(1,5,10,50),
name = "Attack rate per 10,000"
) +
scale_x_log10() +
scale_y_log10(limits=c(1e-3,25)) +
geom_smooth(
method = "loess",
formula = y ~ x,
span = 0.8,   # tweak smoothness (smaller = wigglier)
color = "black",
se = TRUE
)+
guides(
shape = guide_legend(override.aes = list(fill = "white")), # nicer shape legend
fill  = guide_colorbar(title.position = "top")
) +
labs(x="Population size", y="Case averted per 1,000 OCVs")+
theme_light() +
theme_tight()
dat %>%
ggplot(aes(outbreak_pop, case_averted_per_1000_OCV,
fill = ar_per_10e3, shape = spatial_scale)) +
geom_point(size = 3.2, color = "grey20", stroke = 0.3) +  # color=outline; stroke=outline width
scale_shape_manual("",
values = c(admin1 = 21, admin2 = 22, admin3 = 24),
labels = c("adm 1", "adm 2", "adm 3")) +
scale_fill_gradientn(
trans = scales::pseudo_log_trans(),
colours = myPalette(100),
breaks = c(1,5,10,50),
name = "Attack rate per 10,000"
) +
scale_x_log10() +
scale_y_log10(limits=c(1e-3,25)) +
geom_smooth(
method = "lm",
formula = y ~ log10(x),
color = "black",
linetype = "dashed",
se = TRUE # set FALSE if you don't want the ribbon
)+
