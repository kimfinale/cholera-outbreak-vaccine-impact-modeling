# --- 2. Perform Analysis with a Single, Vectorized Operation ---
# Convert input data.frames to data.tables
setDT(subset_data)
subset_dt <- subset_data %>%
filter(sampled == TRUE, vacc_priority == "AR", id_sample == 1)
# Perform the operations using data.table
res_list <- vector('list', 200)
for (i in 1:length(res_list)) {
subset_dt <- subset_data %>%
filter(sampled == TRUE, !is.na(id_sample),
vacc_priority == "AR", id_sample == i)
res_list[[i]] <- cea_data[subset_dt, on = .(id_outbreak), allow.cartesian = TRUE][
, .(
sum_pop = sum(pop),
sum_vacc_dose = sum(vacc_dose),
sum_s_ch = sum(s_ch_tot),
sum_s_ch_averted = sum(s_ch_averted_tot),
percent_case_averted = 100 * sum(s_ch_averted_tot) / sum(s_ch_tot),
case_averted_per_1000_OCV = 1000 * sum(s_ch_averted_tot) / sum(vacc_dose),
n_outbreaks_in_subset = .N
),
# by = .(prob, id_sample, ocv_dose, runid, vacc_week)
by = .(prob, id_sample, ocv_dose, runid, vacc_week)
]
}
res1 <- rbindlist(res_list)
# Ensure the result is not grouped (data.table automatically drops grouping)
setkey(res1, NULL)
# Ensure res1 is a data.table. This modifies res1 in place for efficiency.
# setDT(res1)
# summary across runid's and id_sample's
res <- res1[, .(
pop_q500 = median(sum_pop),
vacc_dose_q500 = median(sum_vacc_dose),
s_ch_q500 = median(sum_s_ch),
s_ch_averted_q500 = median(sum_s_ch_averted),
percent_case_averted_q500 = median(percent_case_averted),
case_averted_per_1000_OCV_q500 = median(case_averted_per_1000_OCV, na.rm = TRUE),
n_outbreaks_in_subset_q500 = median(n_outbreaks_in_subset)
),
by = .(prob, ocv_dose, vacc_week)
]
# --- 3. Save the Final Output ---
if (save_rds) {
saveRDS(res, paste0("outputs/cea_dose_ar_priority_", tstamp(), ".rds"))
}
