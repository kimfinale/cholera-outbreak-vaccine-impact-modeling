whisker_95 = line_width_95
) +
scale_y_continuous("% cases averted",
labels = scales::percent_format(scale = 1),
limits=c(0,100)) +
scale_color_manual(
name = "",
values = my_discrete_colors[1:3],
labels = c(paste0(format_num(VC3*100, 1), "%")))+
theme_light() +
theme_tight() +
theme_x_blank()
# plot 2
# exponential decay curve
set.seed(42)
## ---- sampling / filtering (unchanged except vacc_cov) ----
runid_sample <- 1
# decay model was fit using the first 5, 9, 13 points and they
ids_wk_5 <- fit_decay$`5` %>%
filter(!(id_outbreak %in% unique(fit_decay$`9`$id_outbreak))) %>%
pull(id_outbreak) %>% unique()
id_outbreak_sample_wk_5 <- sample(ids_wk_5, size = 10)
fitted_models <- fit_decay$`5` %>%
filter(runid %in% runid_sample,
id_outbreak %in% id_outbreak_sample_wk_5,
vacc_cov == 0.75)
# x-axis grid
x_range <- seq(1, 15, by = 0.2)
t0 <- 1  # baseline week for normalization
## ---- normalized "spaghetti" using fitted params ----
# On the normalized scale, A0 cancels; z_hat(t) = exp(-k * (t - t0))
spaghetti_data_norm_wk_5 <- fitted_models %>%
mutate(vacc_week = list(x_range)) %>%
unnest(vacc_week) %>%
mutate(
z_hat = exp(-decay_rate_k * (vacc_week - t0))
)
ids_wk_9 <- fit_decay$`9` %>%
filter(!(id_outbreak %in% unique(fit_decay$`13`$id_outbreak))) %>%
pull(id_outbreak) %>% unique()
id_outbreak_sample_wk_9 <- sample(ids_wk_9, size = 10)
fitted_models <- fit_decay$`9` %>%
filter(runid %in% runid_sample,
id_outbreak %in% id_outbreak_sample_wk_9,
vacc_cov == 0.75)
## ---- normalized "spaghetti" using fitted params ----
# On the normalized scale, A0 cancels; z_hat(t) = exp(-k * (t - t0))
spaghetti_data_norm_wk_9 <- fitted_models %>%
mutate(vacc_week = list(x_range)) %>%
unnest(vacc_week) %>%
mutate(
z_hat = exp(-decay_rate_k * (vacc_week - t0))
)
ids_wk_13 <- unique(fit_decay$`13`$id_outbreak)
id_outbreak_sample_wk_13 <- sample(ids_wk_13, size = 10)
fitted_models <- fit_decay$`13` %>%
filter(runid %in% runid_sample,
id_outbreak %in% id_outbreak_sample_wk_13,
vacc_cov == 0.75)
## ---- normalized "spaghetti" using fitted params ----
# On the normalized scale, A0 cancels; z_hat(t) = exp(-k * (t - t0))
spaghetti_data_norm_wk_13 <- fitted_models %>%
mutate(vacc_week = list(x_range)) %>%
unnest(vacc_week) %>%
mutate(
z_hat = exp(-decay_rate_k * (vacc_week - t0))
)
# k_hat and half_life colums are generated during fitting
# It, however, occurs only for the first 5 weeks (weeks 1-5)
# and therefore set to NULL. before joining with weeks 1-9 and weeks 1-13
# results
spaghetti_data_norm_wk_5$k_hat <- NULL
spaghetti_data_norm_wk_5$half_life <- NULL
spaghetti_data_norm <- rbindlist(list(spaghetti_data_norm_wk_5,
spaghetti_data_norm_wk_9,
spaghetti_data_norm_wk_13))
id_outbreak_sample <- c(id_outbreak_sample_wk_5, id_outbreak_sample_wk_9,
id_outbreak_sample_wk_13)
## ---- raw data, normalized by week-1 value per series ----
# Expecting 'cea_ori' with columns: vacc_cov, ori_occurred, vacc_week, runid, id_outbreak, pct_reduc_case
raw_data_points_norm <- cea_ori %>%
filter(vacc_cov == 0.75,
vacc_week %in% 1:15,
runid %in% runid_sample,
id_outbreak %in% id_outbreak_sample) %>%
arrange(runid, id_outbreak, vacc_week) %>%
group_by(runid, id_outbreak) %>%
mutate(
y0 = first(pct_reduc_case),
z  = ifelse(y0 > 0, pct_reduc_case / y0, NA_real_)
) %>%
ungroup()
## ---- summary curves from k only (median + IQR) ----
# Use the full data set
# k_q <- quantile(fit_decay$`5`$decay_rate_k,
#                 probs = c(0.025, .25, .5, .75, 0.975), na.rm = TRUE)
k_q <- quantile(fit_decay$`9`$decay_rate_k,
probs = c(0.025, .25, .5, .75, 0.975), na.rm = TRUE)
k_q025 <- k_q[[1]]; k_q25 <- k_q[[2]]; k_med <- k_q[[3]];
k_q75 <- k_q[[4]]; k_q975 <- k_q[[5]]
summary_curves_norm <- tibble(
vacc_week = x_range,
med = exp(-k_med * (x_range - t0)),
lo  = exp(-k_q75 * (x_range - t0)),  # faster decay => lower envelope
hi  = exp(-k_q25 * (x_range - t0)),   # slower decay => higher envelope
q975   = exp(-k_q975 * (x_range - t0)),  # faster decay => lower envelope
q025  = exp(-k_q025 * (x_range - t0))   # slower decay => higher envelope
)
## ---- pretty label (normalized) ----
format_k <- paste0(round(k_med, digits = 3))
eq_label_norm <- paste0("$\\hat{z}(t)=\\exp\\{-", format_k, "(t-1)\\}$")
## ---- plot (normalized scale 0-1) ----
p2 <- ggplot() +
# Individual normalized fitted curves
geom_line(
data = spaghetti_data_norm,
aes(x = vacc_week, y = z_hat, group = id_outbreak, color = id_outbreak),
alpha = 0.60
) +
# Raw points, normalized by their own week-1
geom_point(
data = raw_data_points_norm,
aes(x = vacc_week, y = z, color = id_outbreak),
alpha = 0.60, size = 1
) +
# Median + IQR summary on normalized scale
geom_ribbon(
data = summary_curves_norm,
aes(x = vacc_week, ymin = lo, ymax = hi),
inherit.aes = FALSE,
fill = "firebrick",
alpha = 0.30
) +
geom_ribbon(
data = summary_curves_norm,
aes(x = vacc_week, ymin = q025, ymax = q975),
inherit.aes = FALSE,
fill = "firebrick",
alpha = 0.20
) +
geom_line(
data = summary_curves_norm,
aes(x = vacc_week, y = med),
color = "firebrick",
linewidth = 1.2
) +
annotate(
"latex",
x = 15, y = 1,
label = eq_label_norm,
size = 4.5, hjust = 1, vjust = 1
) +
# scale_y_continuous("Normalized reduction", limits = c(0, 1)) +
scale_y_continuous("Normalized reduction") +
guides(color = "none") +
theme_light() +
theme_tight() +
theme_x_blank()
# plot 3
# Calculate proportion of outbreaks included
# outbreaks missed by delayed vaccination
wks_delay <- 1:15
dur_missed_id <- vector('list', length(wks_delay))
vax_missed_id <- vector('list', length(wks_delay))
for (i in 1:length(wks_delay)) {
outbk_data_summary %>%
filter(duration_weeks <= wks_delay[i]) %>%
pull(id_outbreak) -> dur_missed_id[[i]]
cea %>%
filter(vacc_week == wks_delay[i] & runid == 1 & vacc_cov == 0.75) %>%
filter(!ori_occurred) %>%
pull(id_outbreak) -> vax_missed_id[[i]]
}
n_outbreaks_missed1 <- map_vec(dur_missed_id, function(i) length(i))
n_outbreaks_missed2 <- map_vec(vax_missed_id, function(i) length(i))
n_outbreaks <- nrow(outbk_data_summary)
prop_df <- data.frame(
vacc_week = 1:15,
prop_included_dur = (1 - n_outbreaks_missed1 / n_outbreaks),
prop_included_vax = (1 - n_outbreaks_missed2 / n_outbreaks))
df <- prop_df %>%
select(vacc_week, prop_included_vax) %>%
filter(vacc_week >= 4)
# --- fit linear model: percent-points per week ---
m <- lm(prop_included_vax ~ vacc_week, data = df)
co <- coef(m)
alpha <- unname(co[1])   # intercept
beta  <- unname(co[2])   # slope (expected to be negative)
r2    <- summary(m)$r.squared
# --- prediction grid & values ---
x_grid <- seq(min(df$vacc_week), max(df$vacc_week), length.out = 200)
pred   <- predict(m, newdata = data.frame(vacc_week = x_grid))
# --- a tidy equation label using LaTeX (percent scale) ---
# round for display
alpha_lab <- format(round(alpha, 2), nsmall = 2)
beta_lab  <- format(round(beta, 3), nsmall = 3)
r2_lab    <- format(round(r2, 3), nsmall = 3)
eq_label <- paste0(
"$\\hat{y}(t) = ", alpha_lab, beta_lab, "\\, t$"
)
p3 <- ggplot() +
# raw data (black)
geom_point(
data = prop_df,
aes(vacc_week, prop_included_vax),
color = "black", size = 2
) +
# fitted line (firebrick)
geom_line(
aes(x_grid, pred),
color = "firebrick", linewidth = 1.2
) +
# equation label (LaTeX)
annotate(
"latex",
x = 15, y = 1,
label = eq_label,
size = 4,
hjust = 1, vjust = 1
) +
# scale_x_continuous("Delay in ORI implementation (weeks)",
#                    breaks = seq(1, 15, 2), limits=c(1,15)) +
scale_y_continuous("Proportion included") +
theme_light() +
theme_tight()
hj <- 3.4
vj <- -0.3
sz <- 5
# A, B, and C annotations
p1_tag <- p1 +
annotate("text", x = -Inf, y = Inf, label = "A",
hjust = hj, vjust = vj, size = sz) +
scale_x_continuous(breaks=seq(1,15,2), limits=c(0.2,15.5))+
coord_cartesian(clip = "off")
p2_tag <- p2 +
annotate("text", x = -Inf, y = Inf, label = "B",
hjust = hj, vjust = vj, size = sz) +
scale_x_continuous(breaks=seq(1,15,2), limits=c(0.2,15.5))+
coord_cartesian(clip = "off")
p3_tag <- p3 +
annotate("text", x = -Inf, y = Inf, label = "C",
hjust = hj, vjust = vj, size = sz) +
scale_x_continuous("Delay in ORI implementation (weeks)",
breaks=seq(1,15,2), limits=c(0.2,15.5))+
coord_cartesian(clip = "off")
plt3 <- (p1_tag / p2_tag / p3_tag) + plot_layout(ncol=1)
if (save_plot) {
fac <- 1.35
ggsave(paste0("plots/fig3_onset_triggered_", tstamp(), ".pdf"),
plt3,
device = cairo_pdf, width = fgw1*fac,
height = fgw2*fac*fac, units = "mm")
}
capd_files <- c(
"outputs/paper/cea_onset_trigger_10m_doses_ar_cutoff_20250922.rds",
"outputs/paper/cea_onset_trigger_10m_doses_size_cutoff_20250922.rds",
"outputs/paper/cea_onset_trigger_10m_doses_dur_cutoff_20250922.rds"
)
capd_data <- map(capd_files, read_rds)
# 1. Create the color palette function (your code was correct here)
myPalette <- colorRampPalette(brewer.pal(9, "YlOrBr"))
# 3. Build the complete, polished plot
plts <- vector('list', length(capd_data))
y_labs <- c("Attack rate percentile", "Outbreak duration percentile",
"Outbreak size percentile")
y_annotations <- c("Prioritizing high AR outbreaks",
"Prioritizing longer outbreaks",
"Prioritizing larger outbreaks")
p1  <- capd_data[[1]] %>% filter(vacc_cov == 0.75) %>%
ggplot(aes(x = vacc_week, y = size_prob_cutoff,
fill = case_averted_per_1000_OCV_q500)) +
geom_tile(color = "white", linewidth = 0.25) +
scale_fill_gradientn(
trans = scales::pseudo_log_trans(),
colours = myPalette(100), # Generate a smooth ramp of 100 colors
breaks = c(1, 2, 5, 10),
limits = c(0.2, 15),
name = "Cases Averted\nper 1,000 OCVs" # Legend title
) +
scale_y_continuous(y_labs[1],
expand = c(0, 0),
breaks = seq(0, 0.8, 0.2),
labels = c(expression(">="*P[0*"%"]),
expression(">="*P[20*"%"]),
expression(">="*P[40*"%"]),
expression(">="*P[60*"%"]),
expression(">="*P[80*"%"]))) +
scale_x_continuous(expand = c(0, 0), breaks = seq(1, 15, 2)) +
# 1. Add the arrows
#    The origin point for all arrows is (x=9, y=0)
annotate(
"segment",
x = 9, y = 0,
xend = c(9, 1), # End points for the three arrows
yend = c(0.9, 0),
arrow = arrow(length = unit(0.3, "cm")),
color = "black",
linewidth = 0.4
) +
# 2. Add the four points on top of the arrows
#    Using shape 21 allows for a fill and a border color
annotate(
"point",
x = c(9), # The four key coordinates
y = c(0),
size = 3,
shape = 21,
fill = "white",
color = "black",
stroke = 1.2
) +
annotate(
"segment",
x = 8, y = 0.5,
xend = c(8, 1), # End points for the three arrows
yend = c(0.9, 0.5),
arrow = arrow(length = unit(0.3, "cm")),
color = "black",
linewidth = 0.4,
linetype = "dashed" # Changed to dashed lines
) +
annotate(
"point",
x = c(8), # The four key coordinates
y = c(0.5),
size = 3,
shape = 21,
fill = "white",
color = "black",
stroke = 1.2
) +
# 3. Add text labels next to the arrows
#    Coordinates are chosen to be midway along the arrow, with a slight offset
annotate(
"text",
x = c(9.5, 5), # x-positions for the two labels
y = c(0.5, 0.05), # y-positions for the two labels
label = c(y_annotations[1], "Reducing ORI delay"),
angle = c(90, 0), # Rotate the vertical label
color = "black",
# fontface = "bold",
size = 4,
hjust = 0.5
) +
# labs(
#   x = "vaccination week<br>(*slower Implementation →*)",
#   y = "attack rate % cutoff<br>(*prioritizing high AR outbreaks →*)"
# ) +
labs(
x = NULL,
y = y_labs[i]
) +
theme_light() +
theme_tight() +
theme(
legend.position = "top",
# plot.margin = margin(0,0.03,0,0)
) +
theme_x_blank()
