annotate(
"segment",
x = 9, y = 0,
xend = c(9, 1), # End points for the three arrows
yend = c(0.9, 0),
arrow = arrow(length = unit(0.3, "cm")),
color = "black",
linewidth = 0.4
) +
annotate(
"point",
x = c(9), # The four key coordinates
y = c(0),
size = 3,
shape = 21,
fill = "white",
color = "black",
stroke = 1.2
) +
annotate(
"segment",
x = 8, y = 0.5,
xend = c(8, 1), # End points for the three arrows
yend = c(0.9, 0.5),
arrow = arrow(length = unit(0.3, "cm")),
color = "black",
linewidth = 0.4,
linetype = "dashed" # Changed to dashed lines
) +
annotate(
"point",
x = c(8), # The four key coordinates
y = c(0.5),
size = 3,
shape = 21,
fill = "white",
color = "black",
stroke = 1.2
) +
annotate(
"text",
x = c(9.5, 5), # x-positions for the two labels
y = c(0.5, 0.05), # y-positions for the two labels
label = c(y_annots[i], "Reducing ORI delay"),
angle = c(90, 0), # Rotate the vertical label
color = "black",
# fontface = "bold",
size = 4,
hjust = 0.5
) +
labs(
x = NULL,
y = y_labs[i]
) +
theme_light() +
theme_tight() +
theme(
legend.position = "top",
) +
theme_x_blank()
}
# daly averted per 1,000 OCVs
impact_data <-
read_rds("outputs/paper/summary_impact_delay_prioritization_20251004.rds")
plot_data <-
impact_data %>% filter(metric == "med_daly_averted_per_1000_OCV")
plot_data %>%
filter(vacc_cov == 0.75) %>%
pull(median_value) %>% range()
# 1. Create the color palette function (your code was correct here)
myPalette <- colorRampPalette(brewer.pal(9, "YlOrBr"))
y_labs <- c("Attack rate percentile", "Outbreak duration percentile",
"Outbreak size percentile",
"CFR percentile")
y_annots <- c("Prioritizing higher AR outbreaks",
"Prioritizing longer outbreaks",
"Prioritizing larger outbreaks",
"Prioritizing higher CFR outbreaks")
fill_limits <- c(1e-5, 1.3)
brks <- c(0.1, 0.5, 1)
legend_title <- "DALYs averted per 1,000 OCVs"
pct_by <- c("ar", "duration", "size", "cfr")
legend_title <- "DALYs averted per 1,000 OCVs"
plts_dapd <- vector('list', 4)
for (i in 1:4) {
plts_dapd[[i]]  <- plot_data %>%
filter(percentile_by == pct_by[i], vacc_cov == 0.75) %>%
ggplot(aes(x = vacc_week, y = prob,
fill = median_value)) +
geom_tile(color = "white", linewidth = 0.25) +
scale_fill_gradientn(
trans = scales::pseudo_log_trans(),
colours = myPalette(100), # Generate a smooth ramp of 100 colors
breaks = brks,
limits = fill_limits,
name = legend_title # Legend title
) +
scale_y_continuous(
expand = c(0, 0),
breaks = seq(0, 0.8, 0.2),
labels = c(expression(">="*P[0*"%"]),
expression(">="*P[20*"%"]),
expression(">="*P[40*"%"]),
expression(">="*P[60*"%"]),
expression(">="*P[80*"%"]))) +
scale_x_continuous(expand = c(0, 0), breaks = seq(1, 15, 2)) +
annotate(
"segment",
x = 9, y = 0,
xend = c(9, 1), # End points for the three arrows
yend = c(0.9, 0),
arrow = arrow(length = unit(0.3, "cm")),
color = "black",
linewidth = 0.4
) +
annotate(
"point",
x = c(9), # The four key coordinates
y = c(0),
size = 3,
shape = 21,
fill = "white",
color = "black",
stroke = 1.2
) +
annotate(
"segment",
x = 8, y = 0.5,
xend = c(8, 1), # End points for the three arrows
yend = c(0.9, 0.5),
arrow = arrow(length = unit(0.3, "cm")),
color = "black",
linewidth = 0.4,
linetype = "dashed" # Changed to dashed lines
) +
annotate(
"point",
x = c(8), # The four key coordinates
y = c(0.5),
size = 3,
shape = 21,
fill = "white",
color = "black",
stroke = 1.2
) +
annotate(
"text",
x = c(9.5, 5), # x-positions for the two labels
y = c(0.5, 0.05), # y-positions for the two labels
label = c(y_annots[i], "Reducing ORI delay"),
angle = c(90, 0), # Rotate the vertical label
color = "black",
# fontface = "bold",
size = 4,
hjust = 0.5
) +
labs(
x = NULL,
y = y_labs[i]
) +
theme_light() +
theme_tight() +
theme(
legend.position = "top",
) +
theme_x_blank()
}
