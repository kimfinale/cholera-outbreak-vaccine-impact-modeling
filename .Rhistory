CPDA = rep(NA, nrow),
ICER = rep(NA, nrow))
if (interval_estimates == "95") {
for (i in 1:nrow) {
tab$PCR[i] <-
format_median_with_95(quantile(d$pct_reduc_case, probs=probs, na.rm=T), digits=1)
tab$CA[i] <-
format_median_with_95(quantile(d$s_ch_averted_tot, probs=probs, na.rm=T), digits=0)
tab$DA[i] <-
format_median_with_95(quantile(d$death_averted_tot, probs=probs, na.rm=T), digits=0)
tab$PDR[i] <-
format_median_with_95(quantile(d$pct_reduc_death, probs=probs, na.rm=T), digits=1)
tab$DR[i] <-
format_median_with_95(quantile(d$dur_reduced, probs=probs, na.rm=T), digits=1)
tab$CAPD[i] <-
format_median_with_95(quantile(d$case_averted_per_1000_OCV, probs=probs, na.rm=T), digits=3)
tab$DAPD[i] <-
format_median_with_95(quantile(d$death_averted_per_1000_OCV, probs=probs, na.rm=T), digits=3)
tab$CPCA[i] <-
format_median_with_95(quantile(d$cost_per_case_averted, probs=probs, na.rm=T), digits=1)
tab$CPDA[i] <-
format_median_with_95(quantile(d$cost_per_death_averted, probs=probs, na.rm=T), digits=1)
tab$ICER[i] <-
format_median_with_95(quantile(d$cost_per_daly_averted, probs=probs, na.rm=T), digits=1)
}
}
else if (interval_estimates == "IQR") {
for (i in 1:nrow) {
tab$PCR[i] <-
format_median_iqr(quantile(d$pct_reduc_case, probs=probs, na.rm=T), digits=1)
tab$CA[i] <-
format_median_iqr(quantile(d$s_ch_averted_tot, probs=probs, na.rm=T), digits=0)
tab$DA[i] <-
format_median_iqr(quantile(d$death_averted_tot, probs=probs, na.rm=T), digits=0)
tab$PDR[i] <-
format_median_iqr(quantile(d$pct_reduc_death, probs=probs, na.rm=T), digits=1)
tab$DR[i] <-
format_median_iqr(quantile(d$dur_reduced, probs=probs, na.rm=T), digits=1)
tab$CAPD[i] <-
format_median_iqr(quantile(d$case_averted_per_1000_OCV, probs=probs, na.rm=T), digits=3)
tab$DAPD[i] <-
format_median_iqr(quantile(d$death_averted_per_1000_OCV, probs=probs, na.rm=T), digits=3)
tab$CPCA[i] <-
format_median_iqr(quantile(d$cost_per_case_averted, probs=probs, na.rm=T), digits=1)
tab$CPDA[i] <-
format_median_iqr(quantile(d$cost_per_death_averted, probs=probs, na.rm=T), digits=1)
tab$ICER[i] <-
format_median_iqr(quantile(d$cost_per_daly_averted, probs=probs, na.rm=T), digits=1)
}
}
return(tab)
}
