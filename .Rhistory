# Calculate proportion of outbreaks included
# outbreaks missed by delayed vaccination
wks_delay <- 1:15
dur_missed_id <- vector('list', length(wks_delay))
vax_missed_id <- vector('list', length(wks_delay))
for (i in 1:length(wks_delay)) {
outbk_data_summary %>%
filter(duration_weeks <= wks_delay[i]) %>%
pull(id_outbreak) -> dur_missed_id[[i]]
cea %>%
filter(vacc_week == wks_delay[i] & runid == 1 & vacc_cov == 0.75) %>%
filter(!ori_occurred) %>%
pull(id_outbreak) -> vax_missed_id[[i]]
}
n_outbreaks_missed1 <- map_vec(dur_missed_id, function(i) length(i))
n_outbreaks_missed2 <- map_vec(vax_missed_id, function(i) length(i))
n_outbreaks <- nrow(outbk_data_summary)
prop_df <- data.frame(
vacc_week = 1:15,
prop_included_dur = (1- n_outbreaks_missed1 / n_outbreaks ),
prop_included_vax = (1- n_outbreaks_missed2 / n_outbreaks))
ymean  <- 91
ymedian<- 85
y50    <- c(82, 88)
y95    <- c(75, 95)
# percentage case averted
p1 <- cea_ori %>%
filter(vacc_cov %in% VC3, vacc_week %in% VW_seq) %>%
ggplot(aes(x = as.factor(vacc_week),
y = pct_reduc_case,
color = as.factor(vacc_cov),
group = as.factor(vacc_cov))) +
ci_layers(
group = as.factor(vacc_cov), color = as.factor(vacc_cov),
dodge_width = line_interval,
lw95 = line_width_95,
lw50 = line_width_50,
pr_size = point_size,
mean_size = x_size,
mean_stroke = x_stroke
)+
add_summary_braces(
x0 = 7,
ymean = ymean, ymedian = ymedian,
y50 = y50, y95 = y95,
pt_size_median = 2,
pt_size_mean = x_size,
pt_stroke_mean = x_stroke,
dx50 = 0.3, dx95 = 0.6,
text_50_x = 7.3,
text_50_y = y50[2],
text_95_x = 8,
text_95_y = y95[2],
brace_50_x = 7.1,
brace_95_x = 7.6,
text_offset_mean = 0.12,
lw_50 = 0.6, lw_95 = 0.6,
whisker_50 = line_width_50,
whisker_95 = line_width_95
) +
scale_y_continuous(labels = scales::percent_format(scale = 1)) +
scale_color_manual(
name = "",
values = my_discrete_colors[1:3],
labels = c(paste0(format_num(VC3*100, 1), "%")))+
# guides(color = "none") +   # <-- removes the legend
# labs(x = NULL, y = "% cases averted") +
labs(x = "Delay in ORI implementation (weeks)", y = "% cases averted") +
theme_light() +
theme_tight() +
theme_x_blank() +
theme(plot.margin = margin(0,0.1,0,0))
# if (save_plot) {
#   fac <- 1.3
#   ggsave(paste0("plots/fig3_pct_case_averted_", tstamp(), ".pdf"),
#          p2,
#          device = cairo_pdf, width = fgw1*fac,
#          height = fgw1*fac, units = "mm")
# }
# exponential decay curve
set.seed(42)
## ---- sampling / filtering (unchanged except vacc_cov) ----
runid_sample <- 1
id_outbreak_sample <- sample(unique(fit_decay$`5`$id_outbreak), size = 20)
fitted_models <- fit_decay$`5` %>%
filter(runid %in% runid_sample,
id_outbreak %in% id_outbreak_sample,
vacc_cov == 0.75)
# x-axis grid
x_range <- seq(1, 15, by = 0.2)
t0 <- 1  # baseline week for normalization
## ---- normalized "spaghetti" using fitted params ----
# On the normalized scale, A0 cancels; z_hat(t) = exp(-k * (t - t0))
spaghetti_data_norm <- fitted_models %>%
mutate(vacc_week = list(x_range)) %>%
unnest(vacc_week) %>%
mutate(
z_hat = exp(-decay_rate_k * (vacc_week - t0))
)
## ---- raw data, normalized by week-1 value per series ----
# Expecting 'cea_ori' with columns: vacc_cov, ori_occurred, vacc_week, runid, id_outbreak, pct_reduc_case
raw_data_points_norm <- cea_ori %>%
filter(vacc_cov == 0.75,
ori_occurred == TRUE,
vacc_week %in% VW_seq,
runid %in% runid_sample,
id_outbreak %in% id_outbreak_sample) %>%
arrange(runid, id_outbreak, vacc_week) %>%
group_by(runid, id_outbreak) %>%
mutate(
y0 = first(pct_reduc_case),
z  = ifelse(y0 > 0, pct_reduc_case / y0, NA_real_)
) %>%
ungroup()
## ---- summary curves from k only (median + IQR) ----
# Use the full data set
k_q <- quantile(fit_decay$`5`$decay_rate_k,
probs = c(0.025, .25, .5, .75, 0.975), na.rm = TRUE)
k_q025 <- k_q[[1]]; k_q25 <- k_q[[2]]; k_med <- k_q[[3]];
k_q75 <- k_q[[4]]; k_q975 <- k_q[[5]]
summary_curves_norm <- tibble(
vacc_week = x_range,
med = exp(-k_med * (x_range - t0)),
lo  = exp(-k_q75 * (x_range - t0)),  # faster decay => lower envelope
hi  = exp(-k_q25 * (x_range - t0)),   # slower decay => higher envelope
q975   = exp(-k_q975 * (x_range - t0)),  # faster decay => lower envelope
q025  = exp(-k_q025 * (x_range - t0))   # slower decay => higher envelope
)
## ---- pretty label (normalized) ----
format_k <- paste0(round(k_med, digits = 3))
eq_label_norm <- paste0("$\\hat{z}(t)=\\exp\\{-", format_k, "(t-1)\\}$")
## ---- plot (normalized scale 0-1) ----
p2 <- ggplot() +
# Individual normalized fitted curves
geom_line(
data = spaghetti_data_norm,
aes(x = vacc_week, y = z_hat, group = id_outbreak, color = id_outbreak),
alpha = 0.60
) +
# Raw points, normalized by their own week-1
geom_point(
data = raw_data_points_norm,
aes(x = vacc_week, y = z, color = id_outbreak),
alpha = 0.60, size = 1
) +
# Median + IQR summary on normalized scale
geom_ribbon(
data = summary_curves_norm,
aes(x = vacc_week, ymin = lo, ymax = hi),
inherit.aes = FALSE,
fill = "firebrick",
alpha = 0.30
) +
geom_ribbon(
data = summary_curves_norm,
aes(x = vacc_week, ymin = q025, ymax = q975),
inherit.aes = FALSE,
fill = "firebrick",
alpha = 0.20
) +
geom_line(
data = summary_curves_norm,
aes(x = vacc_week, y = med),
color = "firebrick",
linewidth = 1.2
) +
annotate(
"latex",
x = 15, y = 1,
label = eq_label_norm,
size = 4.5, hjust = 1, vjust = 1
) +
scale_y_continuous("Normalized reduction", limits = c(0, 1)) +
# scale_x_continuous("Delay in ORI implementation (weeks)",
#                    breaks = seq(1, 15, 2), labels = seq(1, 15, 2)) +
guides(color = "none") +
theme_x_blank() +
theme_light() +
theme_tight()
# Bottom plot: proportion of outbreaks included
df <- prop_df %>%
select(vacc_week, prop_included_vax) %>%
filter(vacc_week >= 4)
# --- fit linear model: percent-points per week ---
m <- lm(prop_included_vax ~ vacc_week, data = df)
co <- coef(m)
alpha <- unname(co[1])   # intercept
beta  <- unname(co[2])   # slope (expected to be negative)
r2    <- summary(m)$r.squared
# --- prediction grid & values ---
x_grid <- seq(min(df$vacc_week), max(df$vacc_week), length.out = 200)
pred   <- predict(m, newdata = data.frame(vacc_week = x_grid))
# --- a tidy equation label using LaTeX (percent scale) ---
# round for display
alpha_lab <- format(round(alpha, 2), nsmall = 2)
beta_lab  <- format(round(beta, 3), nsmall = 3)
r2_lab    <- format(round(r2, 3), nsmall = 3)
eq_label <- paste0(
"$\\hat{y}(t) = ", alpha_lab, beta_lab, "\\, t$"
)
p3 <- ggplot() +
# raw data (black)
geom_point(
data = prop_df,
aes(vacc_week, prop_included_vax),
color = "black", size = 2
) +
# fitted line (firebrick)
geom_line(
aes(x_grid, pred),
color = "firebrick", linewidth = 1.2
) +
# equation label (LaTeX)
annotate(
"latex",
x = 15, y = 1,
label = eq_label,
size = 4,
hjust = 1, vjust = 1
) +
scale_x_continuous("Delay in ORI implementation (weeks)",
breaks = seq(1, 15, 2), limits=c(1,15)) +
scale_y_continuous("Proportion included") +
theme_light() +
theme_tight() +
theme(plot.margin = margin(0,0.1,0,0))
# p3
save_plot <- TRUE
plt <- p1 / p2 / p3
# Now bind the two columns side-by-side
final_plot <- plt + plot_layout(ncol=1) +
plot_annotation(tag_levels = 'A') +
theme(plot.tag.position = c(0.3, 1),
plot.tag = element_text(size = 13))
if (save_plot) {
fac <- 1.3
ggsave(paste0("plots/fig3_onset_triggered_", tstamp(), ".pdf"),
final_plot,
device = cairo_pdf, width = fgw1*fac,
height = fgw2*1.5*fac, units = "mm")
}
plt <- p1 / p2 / p3
# Now bind the two columns side-by-side
final_plot <- plt + plot_layout(ncol=1) +
plot_annotation(tag_levels = 'A') +
theme(plot.tag.position = c(0.3, 1),
plot.tag = element_text(size = 13))
if (save_plot) {
fac <- 1.3
ggsave(paste0("plots/fig3_onset_triggered_", tstamp(), ".pdf"),
final_plot,
device = cairo_pdf, width = fgw1*fac,
height = fgw2*1.5*fac, units = "mm")
}
