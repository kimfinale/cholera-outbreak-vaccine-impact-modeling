ymean  <- 95
ymedian<- 87.5
y50    <- c(82, 93)
y95    <- c(75, 100)
# percentage case averted
p1_alt <- cea_ori %>%
filter(vacc_cov %in% VC3, vacc_week %in% VW_seq) %>%
# ggplot(aes(x = as.factor(vacc_week),
#            y = pct_reduc_case,
#            color = as.factor(vacc_cov),
#            group = as.factor(vacc_cov))) +
ggplot(aes(x = vacc_week,
y = pct_reduc_case,
color = as.factor(vacc_cov),
group = as.factor(vacc_cov))) +
ci_layers(
# group = as.factor(vacc_cov), color = as.factor(vacc_cov),
group = as.factor(vacc_cov), color = as.factor(vacc_cov),
dodge_width = line_interval + 0.1,
lw95 = line_width_95,
lw50 = line_width_50,
pr_size = point_size,
mean_size = x_size,
mean_stroke = x_stroke
)+
add_summary_braces(
x0 = 13,
ymean = ymean, ymedian = ymedian,
y50 = y50, y95 = y95,
pt_size_median = 2,
pt_size_mean = x_size,
pt_stroke_mean = x_stroke,
dx50 = 0.3, dx95 = 0.6,
text_50_x = 13.5,
text_50_y = y50[2],
text_95_x = 14.2,
text_95_y = y95[2],
brace_50_x = 13.2,
brace_95_x = 13.9,
text_offset_mean = 0.2,
lw_50 = 0.6, lw_95 = 0.6,
whisker_50 = line_width_50,
whisker_95 = line_width_95
) +
scale_y_continuous("% cases averted",
labels = scales::percent_format(scale = 1),
limits=c(0,100)) +
scale_color_manual(
name = "",
values = my_discrete_colors[1:3],
labels = c(paste0(format_num(VC3*100, 1), "%")))+
# limits extended to allow three error bars for one x value
scale_x_continuous(breaks = seq(1, 15, 2), limits=c(0.2,15.2)) +
theme_light() +
theme_tight() +
theme_x_blank() +
theme(plot.margin = margin(0,0,0,0))
# A, B, and C annotations
p1_tag <- p1_alt +
annotate("text", x = -Inf, y = Inf, label = "A",
hjust = hj, vjust = vj, size = sz) +
scale_x_continuous(limits=c(0.5, 15.5))+
coord_cartesian(clip = "off")
p2_tag <- p2 +
annotate("text", x = -Inf, y = Inf, label = "B",
hjust = hj, vjust = vj, size = sz) +
scale_x_continuous(limits=c(0.5, 15.5))+
coord_cartesian(clip = "off")
p3_tag <- p3 +
annotate("text", x = -Inf, y = Inf, label = "C",
hjust = hj, vjust = vj, size = sz) +
scale_x_continuous(limits=c(0.5, 15.5))+
coord_cartesian(clip = "off")
final_alt_plot <- (p1_tag / p2_tag / p3_tag) + plot_layout(ncol=1)
fac <- 1.35
ggsave(paste0("plots/fig3_onset_triggered_alt_", tstamp(), ".pdf"),
final_plot,
device = cairo_pdf, width = fgw1*fac,
height = fgw2*fac*fac, units = "mm")
final_plot <- (p1_tag / p2_tag / p3_tag) + plot_layout(ncol=1)
fac <- 1.35
ggsave(paste0("plots/fig3_onset_triggered_alt_", tstamp(), ".pdf"),
final_plot,
device = cairo_pdf, width = fgw1*fac,
height = fgw2*fac*fac, units = "mm")
# Calculate proportion of outbreaks included
# outbreaks missed by delayed vaccination
wks_delay <- 1:15
dur_missed_id <- vector('list', length(wks_delay))
vax_missed_id <- vector('list', length(wks_delay))
for (i in 1:length(wks_delay)) {
outbk_data_summary %>%
filter(duration_weeks <= wks_delay[i]) %>%
pull(id_outbreak) -> dur_missed_id[[i]]
cea %>%
filter(vacc_week == wks_delay[i] & runid == 1 & vacc_cov == 0.75) %>%
filter(!ori_occurred) %>%
pull(id_outbreak) -> vax_missed_id[[i]]
}
n_outbreaks_missed1 <- map_vec(dur_missed_id, function(i) length(i))
n_outbreaks_missed2 <- map_vec(vax_missed_id, function(i) length(i))
n_outbreaks <- nrow(outbk_data_summary)
prop_df <- data.frame(
vacc_week = 1:15,
prop_included_dur = (1 - n_outbreaks_missed1 / n_outbreaks),
prop_included_vax = (1 - n_outbreaks_missed2 / n_outbreaks))
ymean  <- 95
ymedian<- 87.5
y50    <- c(82, 93)
y95    <- c(75, 100)
# percentage case averted
p1_alt <- cea_ori %>%
filter(vacc_cov %in% VC3, vacc_week %in% VW_seq) %>%
ggplot(aes(x = vacc_week,
y = pct_reduc_case,
color = as.factor(vacc_cov),
group = as.factor(vacc_cov))) +
ci_layers(
group = as.factor(vacc_cov), color = as.factor(vacc_cov),
dodge_width = line_interval + 0.2,
lw95 = line_width_95,
lw50 = line_width_50,
pr_size = point_size,
mean_size = x_size,
mean_stroke = x_stroke
)+
add_summary_braces(
x0 = 13,
ymean = ymean, ymedian = ymedian,
y50 = y50, y95 = y95,
pt_size_median = 2,
pt_size_mean = x_size,
pt_stroke_mean = x_stroke,
dx50 = 0.3, dx95 = 0.6,
text_50_x = 13.5,
text_50_y = y50[2],
text_95_x = 14.4,
text_95_y = y95[2],
brace_50_x = 13.2,
brace_95_x = 14.2,
text_offset_mean = 0.25,
lw_50 = 0.6, lw_95 = 0.6,
whisker_50 = line_width_50,
whisker_95 = line_width_95
) +
scale_y_continuous("% cases averted",
labels = scales::percent_format(scale = 1),
limits=c(0,100)) +
scale_color_manual(
name = "",
values = my_discrete_colors[1:3],
labels = c(paste0(format_num(VC3*100, 1), "%")))+
# limits extended to allow three error bars for one x value
scale_x_continuous(breaks = seq(1, 15, 2), limits=c(0.2,15.2)) +
theme_light() +
theme_tight() +
theme_x_blank() +
theme(plot.margin = margin(0,0,0,0))
hj <- 3.4
vj <- -0.3
sz <- 5
# A, B, and C annotations
p1_tag <- p1_alt +
annotate("text", x = -Inf, y = Inf, label = "A",
hjust = hj, vjust = vj, size = sz) +
scale_x_continuous(breaks=seq(1,15,2), limits=c(0.5, 15.5))+
coord_cartesian(clip = "off")
p2_tag <- p2 +
annotate("text", x = -Inf, y = Inf, label = "B",
hjust = hj, vjust = vj, size = sz) +
scale_x_continuous(breaks=seq(1,15,2), limits=c(0.5, 15.5))+
coord_cartesian(clip = "off")
p3_tag <- p3 +
annotate("text", x = -Inf, y = Inf, label = "C",
hjust = hj, vjust = vj, size = sz) +
scale_x_continuous(breaks=seq(1,15,2), limits=c(0.5, 15.5))+
coord_cartesian(clip = "off")
final_plot <- (p1_tag / p2_tag / p3_tag) + plot_layout(ncol=1)
if (save_plot) {
fac <- 1.35
ggsave(paste0("plots/fig3_onset_triggered_alt_", tstamp(), ".pdf"),
final_plot,
device = cairo_pdf, width = fgw1*fac,
height = fgw2*fac*fac, units = "mm")
}
