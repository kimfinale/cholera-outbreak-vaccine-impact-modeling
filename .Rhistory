spaghetti_data_norm_wk_9,
spaghetti_data_norm_wk_13))
id_outbreak_sample <- c(id_outbreak_sample_wk_5, id_outbreak_sample_wk_9,
id_outbreak_sample_wk_13)
## ---- raw data, normalized by week-1 value per series ----
