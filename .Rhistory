# -------- configurable inputs --------
# Metrics you want medians for (edit as needed)
cea_metrics <- c("case_averted_per_100_OCV")  # add more if you like
# -------- helper: summarize medians over an ids list --------
summarize_by_ids <- function(cea, ids_list, probs, metrics = cea_metrics,
id_col = "id_outbreak") {
stopifnot(length(ids_list) == length(probs))
map2_dfr(probs, ids_list, function(p, ids) {
if (length(ids) == 0L) {
# Return an empty tibble with expected columns (so bind_rows works)
return(tibble(
p = numeric(0),
vacc_cov = numeric(0),
vacc_week = numeric(0)
))
}
cea %>%
filter(.data[[id_col]] %in% ids) %>%
group_by(vacc_cov, vacc_week) %>%
summarise(
across(
all_of(metrics),
~ median(.x, na.rm = TRUE),
.names = "med_{.col}"
),
n = n(),                     # how many rows contributed
.groups = "drop"
) %>%
mutate(p = p, .before = 1)
})
}
# -------- run for each percentile definition --------
med_ar   <- summarize_by_ids(cea, ids_list_ar,   probs, metrics = cea_metrics)
