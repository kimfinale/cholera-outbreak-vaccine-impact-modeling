#| warning: false
# Load outbreak data
# All outbreaks including those affected by OCVs
outbreak_data_all <- as.data.frame(fread("outputs/paper/outbreak_data_all_20250228.csv"))
# Outbreaks included in vaccine impact modeling (not affected by OCVs)
outbreak_data <- fread("outputs/paper/outbreak_data_20250228.csv")
# outbreaks filtered
# This includes outbreaks that are finally analyzed and excludes
# outbreaks that were duplicated
outbreaks_filtered <-
readRDS("outputs/paper/outbreak_summary_filtered_20250418.rds")
outbreak_data %<>% filter(id_outbreak %in% outbreaks_filtered$id_outbreak)
# outbreaks excluded
outbreaks_excluded <- read_rds("outputs/paper/outbreaks_excluded_20250612.rds")
# Load OCV campaign data
ocv_use <- fread("outputs/paper/ocv_use_GTFCC_data_20241120.csv")
# Calculate delay statistics between request and round 1 vaccination
delay_req_r1 <- as.integer(ocv_use$DATE_ROUND_ONE - ocv_use$DATE_REQUEST)
# Compute key percentiles of the delay distribution
ocv_delay <- quantile(delay_req_r1, probs = c(0.25, 0.5, 0.75, 0.9), na.rm = TRUE)
# Get historical OCV deployment data
dat <- clean_names(fread("outputs/paper/OCV_Use_GTFCC_Dashboard.csv"))
dat |>
filter(shipped == "Shipped", type == "Reactive") |>
group_by(year) |>
summarize(num_ocv = sum(dose)) |>
setDT() -> ocv_year
ocv_year$cum_num_ocv <- cumsum(ocv_year$num_ocv)
# Load OCV campaign dataset
docv_ <- clean_names(fread("data/paper/outbreak_files_Oct2024/ocv_long_dataset.csv"))
docv <- docv_[(ocv_before_1 == TRUE | ocv_before_2 == TRUE |
ocv_before_3 == TRUE | ocv_during == TRUE)]
# Load model parameters
dis_params <- as.data.frame(data.table::fread("data/paper/parameters.csv"))
# Load IVE posterior predictive values from Bayesian beta regression
# ive_fit <- read_rds("outputs/ive_yrep_20241010.rds")
ive_fit <- readRDS("outputs/paper/ive_yhat_yrep_20250919.rds")
ive_data <- ive_fit$yrep
rm(ive_fit)  # Free memory by removing large object
# Load outbreak summary data
ds <- clean_names(as.data.frame(fread("data/paper/outbreak_files_Oct2024/outbreak_summary.csv")))
message(paste0(length(unique(ds$country)), " countries"))
# Create unique outbreak identifiers
ds |>
group_by(location, outbreak_number) |>
mutate(id_outbreak = paste0(location, "-", start_date, "-", end_date)) |>
ungroup() -> ds
# Join outbreak data with summary information
outbk_data_summary <-
left_join(
filter(outbreak_data, week == 1),
ds[, c("outbreak_pop", "total_s_ch", "total_c_ch", "total_deaths", "duration_weeks",
"peak_week_incidence", "time_to_peak_week", "peak_week_incidence_per_100percent",
"peak_week_incidence_per_10e3", "mean_r0_1st_week", "area_per_1km2",
"rural_urban", "ar_per_10e3", "cfr_per_100percent", "id_outbreak")],
by = "id_outbreak"
)
outbk_data_summary %<>% filter(id_outbreak %in% outbreaks_filtered$id_outbreak)
# Summarize attack rates and population sizes
summary(outbk_data_summary$ar_per_10e3)
summary(outbk_data_summary$outbreak_pop)
