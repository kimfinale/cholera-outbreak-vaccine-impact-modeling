vax_missed_id <- vector('list', length(wks_delay))
for (i in 1:length(wks_delay)) {
outbk_data_summary %>%
filter(duration_weeks <= wks_delay[i]) %>%
pull(id_outbreak) -> dur_missed_id[[i]]
cea %>%
filter(vacc_week == wks_delay[i] & runid == 1 & vacc_cov == 0.75) %>%
filter(!ori_occurred) %>%
pull(id_outbreak) -> vax_missed_id[[i]]
}
n_outbreaks_missed1 <- map_vec(dur_missed_id, function(i) length(i))
n_outbreaks_missed2 <- map_vec(vax_missed_id, function(i) length(i))
n_outbreaks_missed1
100 * n_outbreaks_missed1 / nrow(outbk_data_summary)
100 * n_outbreaks_missed2 / nrow(outbk_data_summary)
# 60%, 75%, 90% at week 1
onset_impact %>% filter(vacc_week == 1) %>% format_median_iqr(row=1:3, digits=0)
# 60%, 75%, 90% at week 9
onset_impact %>% filter(vacc_week == 9) %>% format_median_iqr(row=1:3, digits=0)
# percentage case reduction by size group
probs <- seq(0, 1, by = 0.1)
unq_data <- filter(cea, runid == 1 & vacc_cov == 0.75 & vacc_week == 1)
size_grp_cutoff <- quantile(unq_data$s_ch_tot, probs = probs)
d <- cea
d <- left_join(d, outbk_data_summary[,
c("id_outbreak", "ar_per_10e3","duration_weeks")],
by = "id_outbreak")
# d$size_grp <- sapply(d$s_ch_tot, function(x) get_group_id(x, size_grp_cutoff))
#
# d <- d[ori_occurred == T]
# res <- rbindlist(lapply(1:10, function(i) calculate_impact_by_subset(d, i)))
# res %>% filter(vacc_week %in% c(1,5,9), subset_id %in% c(1,10), vacc_cov == VC)
# rate of decrease in percentage case reduction
# by size, attack rate, and duration
ar_grp_cutoff <- quantile(outbk_data_summary$ar_per_10e3, probs = probs)
dur_grp_cutoff <- quantile(outbk_data_summary$duration_weeks, probs = probs)
d %<>%
group_by(runid, id_outbreak, vacc_cov) %>%
mutate(pct_reduc_case_frac = 1-frac_change(pct_reduc_case, lag=1),
pct_reduc_case_diff = c(1, -diff(pct_reduc_case, lag=1)))
d %>% filter(vacc_cov == 0.75) -> d1
d1$grp <- "All"
d %>% filter(ar_per_10e3 > ar_grp_cutoff[10]) -> d2 # top 10%
d2$grp <- "AR"
d %>% filter(duration_weeks > dur_grp_cutoff[10]) -> d3 # top 10%
d3$grp <- "Dur"
d %>% filter(s_ch_tot > size_grp_cutoff[10]) -> d4 # top 10%
d4$grp <- "Size"
d <- rbind(d1, d2)
d_ <- rbind(d3, d4)
d <- rbind(d, d_)
d %>%
filter(vacc_week > 1, vacc_week <= 15) %>%
mutate(half_life = log(2)/abs(pct_reduc_case_frac)) %>%
group_by(grp) %>%
summarize_quantiles(pct_reduc_case_frac*100, half_life) -> res
res$grp <- factor(res$grp, c("All", "AR", "Dur", "Size"))
for (i in 1:4) print(format_median_iqr(res, row=i))
for (i in 5:8) print(format_median_iqr(res, digits=3, row=i))
# percentage reduction in an original scale
# 1 - exp(-k_hat)
names(fit_decay)
fit_decay[["5"]] %>%  # outbreaks 5 weeks or longer
filter(vacc_cov == VC) %>%
mutate(rate_reduc = 100*(1 - exp(-k_hat))) %>%
summarize_group(vars=c("rate_reduc"), group_name="> 5 weeks") %>%
format_median_iqr(digits=1)
fit_decay[["5"]] %>%  # outbreaks 5 weeks or longer
filter(vacc_cov == VC) %>%
summarize_group(vars=c("half_life"), group_name="> 5 weeks") %>%
format_median_iqr(digits=1)
rm(d, d1, d2, d3, d4, res, onset_impact)
