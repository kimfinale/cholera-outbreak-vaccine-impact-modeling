# plot 2
# exponential decay curve
set.seed(42)
## ---- sampling / filtering (unchanged except vacc_cov) ----
runid_sample <- 1
# decay model was fit using the first 5, 9, 13 points and they
ids_wk_5 <- fit_decay$`5` %>%
filter(!(id_outbreak %in% unique(fit_decay$`9`$id_outbreak))) %>%
pull(id_outbreak) %>% unique()
id_outbreak_sample_wk_5 <- sample(ids_wk_5, size = 10)
fitted_models <- fit_decay$`5` %>%
filter(runid %in% runid_sample,
id_outbreak %in% id_outbreak_sample_wk_5,
vacc_cov == 0.75)
# x-axis grid
x_range <- seq(1, 15, by = 0.2)
t0 <- 1  # baseline week for normalization
## ---- normalized "spaghetti" using fitted params ----
# On the normalized scale, A0 cancels; z_hat(t) = exp(-k * (t - t0))
spaghetti_data_norm_wk_5 <- fitted_models %>%
mutate(vacc_week = list(x_range)) %>%
unnest(vacc_week) %>%
mutate(
z_hat = exp(-decay_rate_k * (vacc_week - t0))
)
ids_wk_9 <- fit_decay$`9` %>%
filter(!(id_outbreak %in% unique(fit_decay$`13`$id_outbreak))) %>%
pull(id_outbreak) %>% unique()
id_outbreak_sample_wk_9 <- sample(ids_wk_9, size = 10)
fitted_models <- fit_decay$`9` %>%
filter(runid %in% runid_sample,
id_outbreak %in% id_outbreak_sample_wk_9,
vacc_cov == 0.75)
## ---- normalized "spaghetti" using fitted params ----
# On the normalized scale, A0 cancels; z_hat(t) = exp(-k * (t - t0))
spaghetti_data_norm_wk_9 <- fitted_models %>%
mutate(vacc_week = list(x_range)) %>%
unnest(vacc_week) %>%
mutate(
z_hat = exp(-decay_rate_k * (vacc_week - t0))
)
ids_wk_13 <- unique(fit_decay$`13`$id_outbreak)
id_outbreak_sample_wk_13 <- sample(ids_wk_13, size = 10)
fitted_models <- fit_decay$`13` %>%
filter(runid %in% runid_sample,
id_outbreak %in% id_outbreak_sample_wk_13,
vacc_cov == 0.75)
## ---- normalized "spaghetti" using fitted params ----
# On the normalized scale, A0 cancels; z_hat(t) = exp(-k * (t - t0))
spaghetti_data_norm_wk_13 <- fitted_models %>%
mutate(vacc_week = list(x_range)) %>%
unnest(vacc_week) %>%
mutate(
z_hat = exp(-decay_rate_k * (vacc_week - t0))
)
# k_hat and half_life colums are generated during fitting
# It, however, occurs only for the first 5 weeks (weeks 1-5)
# and therefore set to NULL. before joining with weeks 1-9 and weeks 1-13
# results
spaghetti_data_norm_wk_5$k_hat <- NULL
spaghetti_data_norm_wk_5$half_life <- NULL
